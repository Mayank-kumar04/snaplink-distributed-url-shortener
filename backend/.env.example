# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL - your database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=snaplink
DB_USER=snaplink
DB_PASSWORD=snaplink123

# Redis - your cache connection
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=   # uncomment if your Redis requires auth

# App
BASE_URL=http://localhost:5000   # URL where backend runs (used for building short links)
FRONTEND_URL=http://localhost:5173

# Cache TTL (how long URLs stay in Redis before expiring)
CACHE_TTL_SECONDS=86400   # 24 hours
