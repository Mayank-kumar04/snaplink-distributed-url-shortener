{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://snaplink-distributed-url-shortener-production.up.railway.app/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/:code([A-Za-z0-9_-]{7})",
      "destination": "https://snaplink-distributed-url-shortener-production.up.railway.app/:code",
      "permanent": false
    }
  ]
}
